// settings.json (workspace)
{
    // Run On Save - automatic render on .py file save
    "runOnSave.statusMessageTimeout": 3000,
    "runOnSave.commands": [
      {
        "match": ".*\\.py$",
        "notMatch": "boot\\.py$",
        "command": "cd ${workspaceFolder} && FILE=${file} python -c 'import os; import boot; boot.render(os.environ[\"FILE\"])'"
      }
    ],

    // Task Buttons - simple buttons at the bottom of the screen
    "VsCodeTaskButtons.showCounter": false,
    "VsCodeTaskButtons.tasks": [
      {
        "label": "$(eye) Render",
        "task": "Render: Current file"
      },
      {
        "label": "$(export) Export STL",
        "task": "Export: Current file to STL"
      }
    ],

    // OCP Viewer settings
    "ocp-cad-viewer.backend.autoStart": true,
    "ocp-cad-viewer.backend.hideTerminal": true,
    "ocp-cad-viewer.view.editorGroup": "two",  // Always open viewer on the right (second column)
    "ocp-cad-viewer.view.autoUpdateOnSave": true,  // Auto-update on save
    "ocp-cad-viewer.view.dark": true,  // Dark theme for viewer
    "ocp-cad-viewer.view.reset_camera": "KEEP",  // Keep camera position
    "ocp-cad-viewer.render.default_color": "#528dc1",  // Default model color
    "ocp-cad-viewer.render.default_edgecolor": "#303030",  // Default edge color

    // Layout settings - new files open in the active column (left)
    "workbench.editor.revealIfOpen": true,
    "workbench.editor.openSideBySideDirection": "right",  // On split - new column on the right

    // Python/Pylance settings for build123d
    // boot.py performs dynamic import of build123d at runtime
    "python.analysis.autoImportCompletions": true,
    "python.analysis.autoSearchPaths": true,
    "python.analysis.diagnosticSeverityOverrides": {
      "reportUndefinedVariable": "none",  // Disable errors - boot.py imports dynamically
      "reportMissingImports": "warning"
    }
  }
  