{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Render: Current file",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python -c 'import os; import boot; boot.render(os.environ[\"FILE\"])'",
      "options": {
        "env": {
          "FILE": "${file}",
          "PYTHONUNBUFFERED": "1"
        }
      },
      "presentation": {
        "reveal": "silent",
        "revealProblems": "onProblem",
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Export: Current file to STL",
      "type": "shell",
      "command": "cd ${workspaceFolder} && python -c 'import os; import boot; boot.export_stl(os.environ[\"FILE\"])'",
      "options": {
        "env": {
          "FILE": "${file}",
          "PYTHONUNBUFFERED": "1"
        }
      },
      "problemMatcher": []
    }
  ]
}
