// Recommended keybindings for build123d workspace
// To use: copy these into your global keybindings.json (Ctrl+K Ctrl+S or Cmd+K Cmd+S)
// Or use Command Palette: "Preferences: Open Keyboard Shortcuts (JSON)"
[
  {
    "key": "f5",
    "command": "workbench.action.tasks.runTask",
    "args": "Render: Current file",
    "when": "editorLangId == python"
  },
  {
    "key": "f6",
    "command": "workbench.action.tasks.runTask",
    "args": "Export: Current file to STL",
    "when": "editorLangId == python"
  }
]
